{
  "name": "graphql-codegen-default-documents",
  "version": "1.1.0",
  "description": "GraphQL Code Generator plugin for generating default documents (queries, mutations, subscriptions and 'AllFields' fragments) for your GraphQL schema.",
  "keywords": [
    "graphql",
    "codegen",
    "graphql-codegen",
    "plugin",
    "documents",
    "queries",
    "mutations",
    "subscriptions",
    "fragments",
    "default documents"
  ],
  "author": "Yury Zhytkou, zhitkoff@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zhitkoff/graphql-codegen-default-documents.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -m esnext --outDir dist/esnext && tsc -m commonjs --outDir dist/commonjs",
    "test": "jest --config ./jest.config.js",
    "lint": "tslint src/**/*.ts",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^7.1.0",
    "@graphql-codegen/visitor-plugin-common": "^7.2.5",
    "auto-bind": "^5.0.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/testing": "^5.0.1",
    "@graphql-codegen/typescript-document-nodes": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@types/jest": "^30.0.0",
    "graphql": "^17.0.2",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "ts-jest": "29.4.12",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-tslint-plugin": "^1.0.2"
  },
  "peerDependencies": {
    "graphql": "^17.0.2"
  },
  "resolutions": {
    "graphql": "^17.0.2"
  },
  "overrides": {
    "graphql": "^17.0.2"
  },
  "sideEffects": false,
  "main": "dist/commonjs/index.js",
  "module": "dist/esnext/index.js",
  "typings": "dist/esnext/index.d.ts",
  "typescript": {
    "definition": "dist/esnext/index.d.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
